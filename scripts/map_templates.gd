static func get_layout_for_stage(floor_idx: int, battle_type: String) -> Array:
	if battle_type == "boss":
		return TEMPLATE_BOSS_ARENA
	elif battle_type == "elite":
		var elite_pools = [TEMPLATE_CITADEL, TEMPLATE_DESERT_STORM, TEMPLATE_CANYON]
		return elite_pools[floor_idx % elite_pools.size()]
	else:
		match floor_idx:
			0: return TEMPLATE_CLASSIC
			1: return TEMPLATE_RIVERS
			2: return TEMPLATE_DESERT_STORM
			3: return TEMPLATE_OASIS_DUNES
			4: return TEMPLATE_JUNGLE
			5: return TEMPLATE_CITADEL
			_:
				var all_templates = [
					TEMPLATE_CLASSIC,
					TEMPLATE_RIVERS,
					TEMPLATE_DESERT_STORM,
					TEMPLATE_OASIS_DUNES,
					TEMPLATE_CITADEL,
					TEMPLATE_JUNGLE,
					TEMPLATE_CHECKERBOARD,
					TEMPLATE_CANYON
				]
				return all_templates[randi() % all_templates.size()]
