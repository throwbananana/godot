class_name MapTemplates
extends RefCounted

# Tile Legend:
# 0 = Empty Ground
# 1 = Brick Wall (2x2 Destructible Subdivided)
# 2 = Steel Wall (Indestructible / Plasma Only)
# 3 = Water / River (Bullet passable, tank impassable)
# 4 = Trees / Foliage (Camouflage cover)
# 5 = Anti-Tank Landmine (Hazard trap)
# 6 = Desert Sand Ground (Quicksand / Heavy Drag: 50% slow for normal tanks, boost for Desert Tanks)
# 7 = Sand Dune Block (Single-piece collapse: Whole 48x48 block collapses on bullet impact)
# 8 = Hard Clay Block (Multi-Hit 3HP per quarter sub-block, color changes on damage)
# 9 = Glacial Ice Ground (Slippery surface: Uncontrolled sliding to opposite side with speed boost)
# 10 = Moving Platform Horizontal (Patrols across voids/water carrying tanks, embarking platform)
# 11 = Moving Platform Vertical (Patrols vertically carrying tanks across gaps)
# 12 = Wormhole (Cosmic Spatial Vortex: Teleports unit to random empty ground with warp VFX)
# 13 = Shield Recharge Station (Periodic touch-activated invulnerable energy shield)
# 14 = Wind Blower UP (High-powered industrial turbine blows UP, pushing tanks & bullets)
# 15 = Wind Blower DOWN (Blows DOWN)
# 16 = Wind Blower LEFT (Blows LEFT)
# 17 = Wind Blower RIGHT (Blows RIGHT)
# 18 = Conveyor Belt UP (Accelerates units & bullets forward UP)
# 19 = Conveyor Belt DOWN (Accelerates DOWN)
# 20 = Conveyor Belt LEFT (Accelerates LEFT)
# 21 = Conveyor Belt RIGHT (Accelerates RIGHT)
# 22 = Jump Pad / Super Ejector (Launches units across obstacles with parabolic jump arc)
# 23 = Moving Platform Horizontal, Leftward (Same as 10, patrols LEFT instead of RIGHT)
# 24 = Street Lamp (Illumination beacon, reveals area in Night Mode)
# 25 = Electric Wall (High-voltage barrier: shocks & damages any tank touching it)
# 26 = Explosive Oil Barrel (Volatile fuel drum: explodes when hit, destroys 3x3 surrounding tiles & units)

