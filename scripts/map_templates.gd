					TEMPLATE_DESERT_CYCLONE_RINGS, TEMPLATE_QUICKSAND_MINEFIELD, TEMPLATE_REINFORCED_DUAL_BASTION, TEMPLATE_EXPLOSIVE_DEPOT_MINEFIELD,
					TEMPLATE_BOMB_SWITCH_VAULT, TEMPLATE_MULTI_FACTORY_TRIANGLE, TEMPLATE_EMP_STORM_FORTRESS, TEMPLATE_NAVAL_SUPPLY_HARBOR, TEMPLATE_JAMMER_CANYON_PASS, TEMPLATE_DESERT_OIL_RUSH, TEMPLATE_APEX_TERMINUS,
