					TEMPLATE_GLACIAL_DUAL_AND, TEMPLATE_OMNI_APEX_CRUCIBLE, TEMPLATE_TRIPLE_AND_CRUCIBLE, TEMPLATE_COOP_GATE_ARENA,
					TEMPLATE_ICE_CONVEYOR_SPEEDWAY, TEMPLATE_EMP_STORM_FORTRESS, TEMPLATE_POLAR_EMP_TUNDRA, TEMPLATE_APEX_TERMINUS,
