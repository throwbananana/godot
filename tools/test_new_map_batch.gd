func _init() -> void:
	var maps = [
		["TEMPLATE_MOMENTUM_PINBALL_REDOUBT", TEMPLATE_MOMENTUM_PINBALL_REDOUBT],
		["TEMPLATE_INFERNO_JAMMER_REFINERY", TEMPLATE_INFERNO_JAMMER_REFINERY],
		["TEMPLATE_WARP_TESLA_CRUCIBLE", TEMPLATE_WARP_TESLA_CRUCIBLE],
		["TEMPLATE_FACTORY_BARRICADE_SIEGE", TEMPLATE_FACTORY_BARRICADE_SIEGE],
		["TEMPLATE_TURBINE_FERRY_STRAIT", TEMPLATE_TURBINE_FERRY_STRAIT],
		["TEMPLATE_APEX_SOLAR_COLLIDER", TEMPLATE_APEX_SOLAR_COLLIDER]
	]
	
	for m in maps:
		var name = m[0]
		var grid = m[1]
		var errs = MapTemplates.validate_layout(grid)
		if not errs.is_empty():
			print("FAIL: ", name, " Errors: ", errs)
			assert(false, "Map validation failed for " + name)
		else:
			print("PASS: ", name)
			
	print("🎉 All 6 new map templates validated cleanly! 🎉")
	quit(0)
